{
  "extends": ["@commitlint/config-conventional"],
  "rules": {
    "scope-enum": [
      2,
      "always",
      ["cpu", "gpu", "memory", "disk", "network", "fans", "battery", "processes",
       "touchbar", "menubar", "ui", "dashboard", "settings", "kit", "scripts",
       "ci", "deps", "readme", "release"]
    ],
    "subject-case": [2, "never", ["start-case", "pascal-case", "upper-case"]],
    "header-max-length": [2, "always", 100]
  }
}
