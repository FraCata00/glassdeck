/* Touch Bar */
"Show GlassDeck on the Touch Bar" = "Mostra GlassDeck sulla Touch Bar";
"Placement" = "Collocazione";
"Position" = "Posizione";
"Metrics in the Touch Bar strip" = "Metriche nella striscia Touch Bar";
"Control Strip button" = "Pulsante nel Control Strip";
"Take over the whole Touch Bar" = "Occupa tutta la Touch Bar";
"A compact meter sits in the expanded Control Strip. Tap it for the full-width graphs." = "Un misuratore compatto resta nel Control Strip esteso. Toccalo per aprire i grafici a piena larghezza.";
"GlassDeck occupies the entire Touch Bar. Other apps' bars still take priority while they are frontmost." = "GlassDeck occupa tutta la Touch Bar. Le barre delle altre app hanno comunque la precedenza mentre sono in primo piano.";
"The shrink button steps down through full width, the compact bar and a small meter; only a tap on the smallest one hands the Touch Bar back, and the Control Strip meter brings it straight back." = "Il pulsante di riduzione scala tra piena larghezza, barra compatta e misuratore ridotto: solo toccandolo sul più piccolo la Touch Bar torna al sistema, e il misuratore nel Control Strip la riporta subito indietro.";
"No Touch Bar detected on this Mac. The setting is kept for when GlassDeck runs on one." = "Nessuna Touch Bar rilevata su questo Mac. L'impostazione resta salvata per quando GlassDeck girerà su un Mac che ce l'ha.";
"Left" = "Sinistra";
"Centre" = "Centro";
"Right, beside the Control Strip" = "Destra, accanto al Control Strip";

/* Touch Bar controls, read out by VoiceOver */
"Back to the meters" = "Torna ai misuratori";
"Shrink GlassDeck" = "Riduci GlassDeck";
"Hand the Touch Bar back until the Control Strip meter is tapped" = "Restituisci la Touch Bar al sistema finché non tocchi il misuratore nel Control Strip";
"Use the full Touch Bar" = "Usa tutta la Touch Bar";
"Open the dashboard" = "Apri la dashboard";

/* Window titles */
"GlassDeck Settings" = "Impostazioni GlassDeck";

/* Metrics tab */
"Drag to reorder. The order is shared by the panel, the Touch Bar and the menu bar." = "Trascina per riordinare. L'ordine vale per il pannello, la Touch Bar e la barra dei menu.";

/* Temperature alert */
"Warn when the Mac runs hot" = "Avvisami quando il Mac scalda";
"Warn above" = "Avvisa sopra";
"A notification once the hottest sensor passes %lld°C, and not again until it has cooled down." = "Una notifica quando il sensore più caldo supera %lld°C, e non di nuovo finché non si è raffreddato.";
"Running hot: %1$lld°C, above the %2$lld°C you asked about." = "Sta scaldando: %1$lld°C, sopra i %2$lld°C che avevi impostato.";

/* Moduli */
"Modules" = "Moduli";
"The charge of every paired device that reports one. A device that is not connected keeps publishing the level it was last seen at, so those rows are dimmed and marked rather than hidden." = "La carica di ogni dispositivo abbinato che la comunica. Un dispositivo non connesso continua a pubblicare l'ultimo livello visto, quindi quelle righe restano visibili ma in grigio e con l'indicazione.";
"Nothing paired is reporting a battery level right now." = "Al momento nessun dispositivo abbinato comunica il livello di batteria.";
"Add a time zone" = "Aggiungi un fuso orario";
"Show in the menu bar" = "Mostra nella barra dei menu";
"Off" = "Nessuno";
"Remove this time zone" = "Rimuovi questo fuso orario";
"Rename a row to whatever the clock is for — a city, an office, a colleague. Drag to reorder." = "Rinomina una riga con quello che rappresenta: una città, un ufficio, un collega. Trascina per riordinare.";

